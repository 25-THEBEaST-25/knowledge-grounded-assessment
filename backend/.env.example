# Gemini (required for /evaluation/evaluate and /handwritten/evaluate)
GEMINI_API_KEY=
# Default is the model already used by the baseline evaluator; it is listed at
# https://ai.google.dev/gemini-api/docs/models (stable). Override if unavailable
# in your region/project, e.g. gemini-2.5-flash.
GEMINI_MODEL=gemini-3.6-flash
# Per-request timeout, milliseconds. A slow/hung provider call is turned into
# a 503 (GeminiUnavailableError) rather than hanging the request indefinitely.
# 60s default: DEADLINE_EXCEEDED (504) from the provider has been observed in
# practice with shorter timeouts on larger prompts.
GEMINI_TIMEOUT_MS=60000
# Number of retries (in addition to the initial attempt) for transient
# provider failures: 429 rate limits, 500/502/503/504, and DEADLINE_EXCEEDED-
# style timeouts, with exponential backoff (1s, 2s, ...). Permanent errors
# (bad API key, malformed request, invalid model) are never retried. Bounded
# -- this is never an unbounded/indefinite retry loop.
GEMINI_MAX_RETRIES=2

# PaddleOCR
OCR_LANG=en
OCR_DEVICE=cpu
# OCR_VERSION=PP-OCRv5
OCR_ENABLE_MKLDNN=false
OCR_USE_TEXTLINE_ORIENTATION=false
# Skip PaddleX's network check for model hosts (models are cached in ~/.paddlex)
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# OCR preprocessing (applied only to the copy of the image fed to the OCR
# engine -- see backend/app/services/ocr_service.py:preprocess_for_ocr).
# Upscaling small images and widening contrast are on by default because
# they are low-risk and directly address thin/faint handwriting strokes;
# denoise defaults off because it has not been validated against a real
# handwriting sample and a heavy filter can erode thin strokes.
OCR_UPSCALE=true
OCR_TARGET_LONG_SIDE=2000
OCR_AUTOCONTRAST=true
OCR_DENOISE=false

# Pipeline
REVIEW_CONFIDENCE_THRESHOLD=0.6
CORS_ORIGINS=http://localhost:3000
