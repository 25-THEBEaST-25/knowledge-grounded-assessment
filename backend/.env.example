# Gemini (required for /evaluation/evaluate and /handwritten/evaluate)
GEMINI_API_KEY=
# Default is the model already used by the baseline evaluator; it is listed at
# https://ai.google.dev/gemini-api/docs/models (stable). Override if unavailable
# in your region/project, e.g. gemini-2.5-flash.
GEMINI_MODEL=gemini-3.6-flash
# Per-request timeout, milliseconds. A slow/hung provider call is turned into
# a 503 (GeminiUnavailableError) rather than hanging the request indefinitely.
# 60s default: DEADLINE_EXCEEDED (504) from the provider has been observed in
# practice with shorter timeouts on larger prompts.
GEMINI_TIMEOUT_MS=60000
# Number of retries (in addition to the initial attempt) for transient
# provider failures: 429 rate limits, 500/502/503/504, and DEADLINE_EXCEEDED-
# style timeouts, with exponential backoff (1s, 2s, ...). Permanent errors
# (bad API key, malformed request, invalid model) are never retried. Bounded
# -- this is never an unbounded/indefinite retry loop.
GEMINI_MAX_RETRIES=2

# PaddleOCR
OCR_LANG=en
OCR_DEVICE=cpu
# OCR_VERSION=PP-OCRv5
OCR_ENABLE_MKLDNN=false
OCR_USE_TEXTLINE_ORIENTATION=false
# Skip PaddleX's network check for model hosts (models are cached in ~/.paddlex)
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# OCR preprocessing (applied only to the copy of the image fed to the OCR
# engine -- see backend/app/services/ocr_service.py:preprocess_for_ocr).
# Upscaling small images and widening contrast are on by default because
# they are low-risk and directly address thin/faint handwriting strokes;
# denoise defaults off because it has not been validated against a real
# handwriting sample and a heavy filter can erode thin strokes.
OCR_UPSCALE=true
OCR_TARGET_LONG_SIDE=2000
OCR_AUTOCONTRAST=true
OCR_DENOISE=false

# OCR result cache: OCR is a deterministic function of (image bytes,
# preprocessing config), so a retry after a Gemini-only failure can skip
# straight to evaluation instead of re-running PaddleOCR. Keyed purely by
# image content hash -- no student/session identity in the key, so this can
# never leak one student's result into another's evaluation.
OCR_CACHE_ENABLED=true
OCR_CACHE_MAX_ENTRIES=32

# Per-question uncertainty detection (flags for review, never penalizes):
# OCR confidence below this, or an answer shorter than this many characters
# for a detected question, marks that answer's evidence as uncertain.
OCR_UNCERTAINTY_CONFIDENCE_THRESHOLD=0.55
OCR_UNCERTAINTY_MIN_ANSWER_CHARS=15

# Visual fallback: when an answer's evidence is uncertain (above) AND the
# OCR engine retained the source image, send the cropped answer-region image
# to Gemini alongside the OCR text so it can resolve obvious OCR corruption.
# Never used for confident answers -- this is a gate, not a default.
VISUAL_FALLBACK_ENABLED=true

# Bounded concurrency for multi-question evaluation: at most this many
# Gemini calls in flight at once per assessment. 1 = fully sequential
# (pre-existing behavior). Never unbounded -- this is a hard cap, not a
# thread-pool-size hint.
# Measured (not assumed): a real, isolated benchmark against the Gemini API
# showed it does not process concurrent requests from one key in true
# parallel -- per-call latency inflates under concurrency, and a real
# 3-question evaluation was only ~7% faster at concurrency=3 vs. fully
# sequential, not ~3x. May differ on other API tiers/keys -- verify before
# relying on this for latency SLAs.
MAX_EVALUATION_CONCURRENCY=3

# Pipeline
REVIEW_CONFIDENCE_THRESHOLD=0.6
CORS_ORIGINS=http://localhost:3000
